# ============================================
# VortexManager API - Variables de entorno
# Copiá este archivo como .env y completá los valores.
# ============================================

# Cadena de conexión de Supabase (Project Settings > Database > Connection string > URI)
# Recomendado: "Session pooler" (puerto 5432) o conexión directa.
DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Secreto para firmar los JWT (mínimo 32 caracteres aleatorios).
# Generalo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Puerto del servidor
PORT=4000

# Origen(es) permitidos por CORS (separados por coma)
CLIENT_URL=http://localhost:5173

# Zona horaria usada para calcular "ingresos de hoy"
APP_TIMEZONE=America/Argentina/Buenos_Aires

# development | production
NODE_ENV=development

# Contraseña con la que `npm run db:setup` crea/actualiza el admin de prueba
ADMIN_EMAIL=admin@hayya.com
ADMIN_PASSWORD=admin123
